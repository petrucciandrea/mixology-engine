# ============================================================
# Mixology Engine — Environment Variables (template)
# Copia questo file in `.env` e valorizza secondo necessità.
# `.env` NON deve mai essere committato (vedi .gitignore).
# ============================================================

# --- App ---
ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=mixology
POSTGRES_PASSWORD=mixology_dev_pw
POSTGRES_DB=mixology_engine
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta esposta sull'host. Cambiala se la 5432 e' gia' occupata da un altro
# progetto: la connessione interna fra i container non ne risente.
POSTGRES_HOST_PORT=5432

# URL async (asyncpg) usato dall'app FastAPI e da Alembic
DATABASE_URL=postgresql+asyncpg://mixology:mixology_dev_pw@db:5432/mixology_engine

# --- Redis ---
# Serve solo alla cache del grafo delle affinita'. Con REDIS_URL vuota la
# cache e' disattivata e il grafo si ricostruisce a ogni richiesta: e' la
# configurazione di produzione sui piani gratuiti (ADR-0010).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379/0
