# ============================================================
# Mixology Engine — Environment Variables (template)
# Copia questo file in `.env` e valorizza secondo necessità.
# `.env` NON deve mai essere committato (vedi .gitignore).
# ============================================================

# --- App ---
ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=mixology
POSTGRES_PASSWORD=mixology_dev_pw
POSTGRES_DB=mixology_engine
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL async (asyncpg) usato dall'app FastAPI e da Alembic
DATABASE_URL=postgresql+asyncpg://mixology:mixology_dev_pw@db:5432/mixology_engine

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Embeddings (Step successivo: RAG / pgvector matcher) ---
# Provider locale (sentence-transformers) o esterno; lasciato vuoto per ora,
# verrà attivato quando implementeremo il FlavorGraphMatcher.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
